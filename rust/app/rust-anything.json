{
  "schema": "rust-anything/front-door@1",
  "name": "cron-person",
  "commands": [
    "allow",
    "completion",
    "crontab",
    "dashboard",
    "deny",
    "dir",
    "exec",
    "help",
    "hook",
    "skill",
    "status",
    "task"
  ],
  "units": [
    {
      "name": "hook",
      "crate": "hook-rs",
      "path": "../hook-rs",
      "commands": [
        "hook"
      ],
      "switch": "RUST_ANYTHING_UNIT_HOOK"
    }
  ]
}
